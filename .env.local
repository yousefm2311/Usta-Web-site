SMTP_PASS=
SMTP_FROM="Usta <no-reply@usta.com>"

# ==============================
# SEO / Analytics (اختياري)
# ==============================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# ==============================
# Feature Flags
# ==============================
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_CONTACT=true



