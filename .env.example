# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/usta

# NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# External Collections (Optional, defaults to local models if not provided)
# USTA_CUSTOMERS_COLLECTION=customers
# USTA_ARTISANS_COLLECTION=artisans
# USTA_ORDERS_COLLECTION=requests
# USTA_SERVICES_COLLECTION=categories
